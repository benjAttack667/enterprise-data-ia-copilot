# Dupliquez ce fichier en .env. La clé est facultative : le fallback local reste actif.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Sécurité de l'API. En production, le jeton est obligatoire et l'API refuse
# de démarrer s'il est absent. Générez-le avec : python -c "import secrets; print(secrets.token_urlsafe(48))"
COPILOT_ENVIRONMENT=local
BACKEND_SERVICE_TOKEN=

# Activée par défaut en local, désactivée par défaut en production. Si elle est
# activée avec un jeton, /docs, /redoc et /openapi.json exigent aussi ce jeton.
# API_DOCS_ENABLED=true

# Origines séparées par des virgules pour le frontend Next.js.
FRONTEND_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Limites de la démo publique. L'upload est streamé vers un fichier temporaire,
# puis validé avant activation. Les valeurs ci-dessous bornent aussi le travail
# Pandas et la décompression des fichiers Excel.
MAX_UPLOAD_BYTES=10485760
MAX_DATASET_ROWS=100000
MAX_DATASET_COLUMNS=200
MAX_DATASET_CELLS=2000000
MAX_XLSX_UNCOMPRESSED_BYTES=52428800
MAX_XLSX_COMPRESSION_RATIO=100
MAX_XLSX_ENTRIES=1000

# Quota en mémoire par instance et rétention automatique du volume.
UPLOAD_RATE_LIMIT_REQUESTS=10
UPLOAD_RATE_LIMIT_WINDOW_SECONDS=600
MAX_REPORT_FILES=20
MAX_HISTORY_ENTRIES=500

# Chemins optionnels utiles pour isoler un environnement de test ou un volume.
# COPILOT_UPLOADS_DIR=C:/data/copilot/uploads
# COPILOT_REPORTS_DIR=C:/data/copilot/reports
# COPILOT_DATABASE_PATH=C:/data/copilot/history.db
