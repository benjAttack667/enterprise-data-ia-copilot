# Variables runtime du serveur Next.js. Ne jamais utiliser le préfixe
# NEXT_PUBLIC_ pour ces valeurs : elles ne doivent pas entrer dans le bundle.
BACKEND_INTERNAL_URL=http://localhost:8000
BACKEND_SERVICE_TOKEN=

# Protection de la démonstration publique (12 caractères minimum).
DEMO_ACCESS_PASSWORD=

# Secret aléatoire de 32 octets minimum : python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=
