# Configuration Docker Compose. Dupliquez ce fichier en `.env`.
COPILOT_ENVIRONMENT=production
API_DOCS_ENABLED=false

# Générez trois valeurs différentes avec :
# python -c "import secrets; print(secrets.token_urlsafe(48))"
# Le jeton backend et le secret de session doivent contenir au moins 32 octets.
BACKEND_SERVICE_TOKEN=
DEMO_ACCESS_PASSWORD=
SESSION_SECRET=

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
MAX_UPLOAD_BYTES=10485760
MAX_DATASET_ROWS=100000
MAX_DATASET_COLUMNS=200
MAX_DATASET_CELLS=2000000
MAX_XLSX_UNCOMPRESSED_BYTES=52428800
MAX_XLSX_COMPRESSION_RATIO=100
MAX_XLSX_ENTRIES=1000
UPLOAD_RATE_LIMIT_REQUESTS=10
UPLOAD_RATE_LIMIT_WINDOW_SECONDS=600
MAX_REPORT_FILES=20
MAX_HISTORY_ENTRIES=500

FRONTEND_PORT=3000
BACKEND_PORT=8000
FRONTEND_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
